# Host port → container 8080
HOMEDVR_PORT=8080

# IMPORTANT: absolute path of this repo ON THE DOCKER HOST (not inside container)
# Example: /root/HomeDVR
# One-click update needs this so data/ keeps the same bind mount.
HOMEDVR_HOST_PATH=/root/HomeDVR

# Public URL via your existing Cloudflare Tunnel — shows cloud icon in navbar
# Example: https://cameras.yourdomain.com
PUBLIC_BASE_URL=

# Inside the single container, go2rtc is always localhost
GO2RTC_URL=http://127.0.0.1:1984

# SQLite path inside container
DATABASE_PATH=/data/homedvr.db

# Web one-click update (System page). Needs docker.sock + writable repo mount.
ENABLE_WEB_UPDATE=true

REPO_PATH=/repo
UPDATE_SCRIPT=/repo/scripts/update.sh
CHECK_UPDATE_SCRIPT=/repo/scripts/check-update.sh

APP_VERSION=0.1.0
GIT_SHA=dev

# Not needed if you already have a cloudflared container on home-net
# TUNNEL_TOKEN=
