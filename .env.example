# Host port → container 8080
HOMEDVR_PORT=8080

# Public URL when accessed via Cloudflare Tunnel (optional for LAN-only)
PUBLIC_BASE_URL=https://cameras.example.com

# Inside the single container, go2rtc is always localhost
GO2RTC_URL=http://127.0.0.1:1984

# SQLite path inside container
DATABASE_PATH=/data/homedvr.db

# Web one-click update needs docker.sock mount (default off for simpler install)
ENABLE_WEB_UPDATE=false

REPO_PATH=/repo
UPDATE_SCRIPT=/repo/scripts/update.sh
CHECK_UPDATE_SCRIPT=/repo/scripts/check-update.sh

APP_VERSION=0.1.0
GIT_SHA=dev

# Only for: docker compose --profile tunnel up -d
TUNNEL_TOKEN=
