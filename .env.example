# Public URL when accessed via Cloudflare Tunnel (optional for LAN-only)
PUBLIC_BASE_URL=https://cameras.example.com

# go2rtc internal URL (Docker network default)
GO2RTC_URL=http://go2rtc:1984

# SQLite path inside container / host
DATABASE_PATH=./data/homedvr.db

# Enable web one-click update (requires repo mount + docker.sock)
ENABLE_WEB_UPDATE=true

# Path to repo root inside the api container (for git pull updates)
REPO_PATH=/repo

# Path to update script
UPDATE_SCRIPT=/repo/scripts/update.sh

# App version labels (set at build time in Docker)
APP_VERSION=0.1.0
GIT_SHA=dev

# Cloudflare Tunnel token (from Zero Trust → Tunnels)
# Leave empty to skip cloudflared service
TUNNEL_TOKEN=
